# =============================================================================
# dev — terraform.tfvars.example
# Copy to terraform.tfvars, fill in app_hostname, and run terraform apply.
# Never commit terraform.tfvars — it is in .gitignore.
# =============================================================================

aws_region   = "us-east-1"
app_hostname = "dev.vote.example.com"   # ← change to your domain

# ── VPC ── (10.0.0.0/16 reserved for dev)
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
public_subnet_cidrs  = ["10.0.101.0/24", "10.0.102.0/24"]
single_nat_gateway   = true   # single NAT saves cost in dev

# ── EKS ──
kubernetes_version                   = "1.29"
cluster_endpoint_public_access       = true
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]   # open for dev convenience

# ── Nodes — minimal footprint for dev ──
node_instance_type = "t3.small"
node_desired_size  = 1
node_min_size      = 1
node_max_size      = 2
node_disk_size     = 20

# ── Add-ons ──
nginx_ingress_version  = "4.10.1"
metrics_server_version = "3.12.1"

# ── App ──
deploy_app        = true
deploy_monitoring = false   # monitoring off in dev to save resources
