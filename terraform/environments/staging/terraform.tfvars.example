# =============================================================================
# staging — terraform.tfvars.example
# Copy to terraform.tfvars, fill in app_hostname, and run terraform apply.
# Never commit terraform.tfvars — it is in .gitignore.
# =============================================================================

aws_region   = "us-east-1"
app_hostname = "staging.vote.example.com"   # ← change to your domain

# ── VPC ── (10.1.0.0/16 reserved for staging — avoids overlap with dev/prod)
vpc_cidr             = "10.1.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
private_subnet_cidrs = ["10.1.1.0/24", "10.1.2.0/24"]
public_subnet_cidrs  = ["10.1.101.0/24", "10.1.102.0/24"]
single_nat_gateway   = true   # single NAT is acceptable for staging

# ── EKS ──
kubernetes_version                   = "1.29"
cluster_endpoint_public_access       = true
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]   # tighten before go-live

# ── Nodes — mirrors production sizing for realistic load tests ──
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 4
node_disk_size     = 20

# ── Add-ons ──
nginx_ingress_version  = "4.10.1"
metrics_server_version = "3.12.1"

# ── App ──
deploy_app        = true
deploy_monitoring = true   # monitoring on in staging to validate dashboards/alerts
